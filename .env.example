# Copia este archivo como .env y completa los valores reales.
# NO subas el archivo .env al repositorio.

SECRET_KEY=clave
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Base de datos: 'sqlite' (local) o 'mysql' (EC2 / producción)
DB_ENGINE=mysql

# Solo se utilizan cuando DB_ENGINE=mysql
DB_NAME=eva2_backend
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
